{
  "name": "sovereignty-scorecard",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev --host",
    "build": "astro build",
    "start": "bun ./dist/server/entry.mjs",
    "capture": "bun scripts/capture.ts",
    "asn": "bun scripts/asn.ts",
    "refresh": "bun scripts/refresh.ts",
    "wappalyzer": "bun scripts/wappalyzer.ts",
    "release": "bun run asn && bun run wappalyzer && bun run refresh && astro build"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.8",
    "happy-dom": "~20.14.0",
    "satori": "^0.47.1",
    "tldts": "^7.4.18",
    "wappalyzer-core": "6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2"
  }
}
